{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "laravel-boost": {
                "type": "local",
                "command": [
                    "bash",
                    "vendor/bin/sail",
                    "artisan",
                    "boost:mcp",
                    "--no-interaction"
                ],
                "cwd": ".",
                "environment": {
                    "DOCKER_CONTEXT": "default",
                    "COMPOSE_PROJECT_NAME": "tag-alert"
                }
            }
        }
    }
}
