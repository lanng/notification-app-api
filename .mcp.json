{
    "mcpServers": {
        "laravel-boost": {
            "command": "bash",
            "args": [
                "${CLAUDE_PROJECT_DIR:-.}/vendor/bin/sail",
                "artisan",
                "boost:mcp",
                "--no-interaction"
            ],
            "env": {
                "DOCKER_CONTEXT": "default",
                "COMPOSE_PROJECT_NAME": "tag-alert"
            }
        }
    }
}
